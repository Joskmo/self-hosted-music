# === Домены (production) ===
NAVIDROME_DOMAIN=music.example.com
AUTH_PANEL_DOMAIN=auth.example.com
NAVIDROME_PUBLIC_URL=https://music.example.com
MINIO_DOMAIN=s3.example.com

# === S3 / MinIO ===
# Root credentials for the private S3 API. Generate unique values before deployment.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-unique-password
# Credentials for applications/clients that access only the music bucket.
MINIO_MUSIC_USER=music-client
MINIO_MUSIC_PASSWORD=replace-with-another-long-unique-password

# === Navidrome ===
# Учётные данные админа Navidrome (используются auth-panel для создания пользователей)
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=your-secure-password

# === Database ===
# Пароль PostgreSQL для auth-db
AUTH_DB_PASSWORD=your-secure-db-password
