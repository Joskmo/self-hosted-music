# === Домены (production) ===
NAVIDROME_DOMAIN=music.example.com
AUTH_PANEL_DOMAIN=auth.example.com

# === Navidrome ===
# Учётные данные админа Navidrome (используются auth-panel для создания пользователей)
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=your-secure-password

# === Database ===
# Пароль PostgreSQL для auth-db
AUTH_DB_PASSWORD=your-secure-db-password
